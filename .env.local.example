# --- Supabase (client portal) ---
# Publishable key: safe to expose to the browser; RLS enforces isolation.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Secret key: server-side only, bypasses RLS. Never import this into a client component.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI Realtime (tannlege voice demo on the marketing site) ---
# Copy this file to .env.local and fill in your own values.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Resend (booking emails) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs Agents — kun for klienter i lib/voiceDemo/elevenlabsAgents.ts
# (pilot). Mangler nøkkelen, feiler bare pilot-klientenes agent-knapp.
ELEVENLABS_API_KEY=
# ElevenLabs telefon-pilot: delt hemmelighet for webhook-verktøyene
# (/api/telephony/elevenlabs-tools) og init-webhooken, + digest-credentials
# TeXML-en bruker mot ElevenLabs' SIP-trunk.
ELEVENLABS_TOOLS_SECRET=
ELEVENLABS_SIP_USERNAME=
ELEVENLABS_SIP_PASSWORD=
